# === PostgreSQL (bases de datos estrictamente separadas) ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_postgres_root_change_me

BABASKETET_DB_NAME=babasketet_db
BABASKETET_DB_USER=babasketet_user
BABASKETET_DB_PASSWORD=dev_babasketet_pwd_change_me

ZITADEL_DB_NAME=zitadel_db
ZITADEL_DB_USER=zitadel_user
ZITADEL_DB_PASSWORD=dev_zitadel_pwd_change_me

# === Zitadel (Motor IAM) ===
# Debe tener exactamente 32 caracteres
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
ZITADEL_EXTERNAL_DOMAIN=localhost
ZITADEL_EXTERNAL_PORT=8085
ZITADEL_EXTERNAL_SECURE=false
ZITADEL_ADMIN_USERNAME=admin@babasketet.localhost
ZITADEL_ADMIN_PASSWORD=Password123!

# === Babasketet.API (.NET 10) ===
API_PORT=8080
DEVICE_TOKEN_SIGNING_KEY=Babasketet_Dev_Signing_Key_Change_In_Prod_Min_32_Bytes!
OIDC_ISSUER=http://localhost:8085
OIDC_AUDIENCE=babasketet
OIDC_JWKS_URI=http://zitadel:8080/oauth/v2/keys
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000,http://localhost

# === WillIAM.UI (SvelteKit Custom Login UI) ===
WILLIAM_UI_PORT=3000
WILLIAM_PUBLIC_URL=http://localhost:3000
ZITADEL_API_URL=http://zitadel:8080
ZITADEL_PUBLIC_URL=http://localhost:8085
PUBLIC_RP_ID=localhost
PUBLIC_BABASKETET_APP_URL=http://localhost:8081
# Mock SMS webhook / Dev mode
SMS_PROVIDER=mock

# === Babasketet.WEB (Flutter Web PWA) ===
WEB_PORT=8081

# === Producción (VPS + Caddy TLS) ===
APP_DOMAIN=app.babasketet.example.com
API_DOMAIN=api.babasketet.example.com
AUTH_DOMAIN=auth.babasketet.example.com
LOGIN_DOMAIN=login.babasketet.example.com

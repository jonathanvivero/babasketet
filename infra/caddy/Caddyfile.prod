# Reverse Proxy de produccion para VPS con TLS automatico Let's Encrypt

{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:80
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8080
}

{$AUTH_DOMAIN} {
	encode zstd gzip
	reverse_proxy zitadel:8080 {
		transport http {
			versions h2c 2
		}
	}
}

{$LOGIN_DOMAIN} {
	encode zstd gzip
	reverse_proxy william-ui:3000
}
